#!/bin/bash
# Shubham OS — Kali Mode back ON
# Hidden tools restored, undercover off, state corrected.

STATE_FILE="$HOME/.shubham-os-mode"
CURRENT="kali"
[ -f "$STATE_FILE" ] && CURRENT=$(cat "$STATE_FILE")
if [ "$CURRENT" != "windows" ]; then
  echo "Shubham OS: the system is already in Kali Mode."
  exit 0
fi

APP_DIR="$HOME/.local/share/applications"
MANIFEST="$HOME/.config/shubham-os/hidden-apps.txt"
if [ -f "$MANIFEST" ]; then
  while IFS= read -r base; do
    [ -n "$base" ] && rm -f "$APP_DIR/$base"
  done < "$MANIFEST"
  rm -f "$MANIFEST"
fi

# Undercover has its own check: xfconfd and xfce4-panel must both be running.
# If either one is stopped, it stops with "only works on Xfce desktop" — make sure both are running first.
ensure_xfce_processes() {
  if ! pgrep -u "$(id -un)" xfconfd >/dev/null 2>&1; then
    (xfconfd >/dev/null 2>&1 &)
  fi
  if ! pgrep -u "$(id -un)" xfce4-panel >/dev/null 2>&1; then
    (nohup xfce4-panel >/dev/null 2>&1 &)
  fi
  sleep 1
}
ensure_xfce_processes

if command -v kali-undercover >/dev/null 2>&1; then
  DESKTOP_SESSION=xfce XDG_CURRENT_DESKTOP=XFCE kali-undercover || echo "(error while turning off undercover — the tools are back anyway)"
fi
echo "kali" > "$STATE_FILE"
xfce4-panel -r >/dev/null 2>&1 &
echo "Shubham OS: Kali Mode ON — all tools are back. For the Windows look: shubham-windows"
