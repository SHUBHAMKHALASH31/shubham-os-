#!/bin/bash
# Shubham OS — Kali Mode wapas ON
# Chhupaye gaye tools wapas, undercover band, state sahi.

STATE_FILE="$HOME/.shubham-os-mode"
CURRENT="kali"
[ -f "$STATE_FILE" ] && CURRENT=$(cat "$STATE_FILE")
if [ "$CURRENT" != "windows" ]; then
  echo "Shubham OS: system pehle se Kali Mode me hai."
  exit 0
fi

APP_DIR="$HOME/.local/share/applications"
MANIFEST="$HOME/.config/shubham-os/hidden-apps.txt"
if [ -f "$MANIFEST" ]; then
  while IFS= read -r base; do
    [ -n "$base" ] && rm -f "$APP_DIR/$base"
  done < "$MANIFEST"
  rm -f "$MANIFEST"
fi

# Undercover ka apna check hai: xfconfd + xfce4-panel dono chalte hone chahiye.
# Ek bhi band ho to wo "only works on Xfce desktop" bolke ruk jata hai — pehle dono ko pakka karo.
ensure_xfce_processes() {
  if ! pgrep -u "$(id -un)" xfconfd >/dev/null 2>&1; then
    (xfconfd >/dev/null 2>&1 &)
  fi
  if ! pgrep -u "$(id -un)" xfce4-panel >/dev/null 2>&1; then
    (nohup xfce4-panel >/dev/null 2>&1 &)
  fi
  sleep 1
}
ensure_xfce_processes

if command -v kali-undercover >/dev/null 2>&1; then
  DESKTOP_SESSION=xfce XDG_CURRENT_DESKTOP=XFCE kali-undercover || echo "(undercover band karne me error — tools phir bhi wapas aa gaye hain)"
fi
echo "kali" > "$STATE_FILE"
xfce4-panel -r >/dev/null 2>&1 &
echo "Shubham OS: Kali Mode ON — saare tools wapas. Windows look ke liye: shubham-windows"
