#!/bin/bash
# Shubham OS — Windows Mode ON (deep switch)
# Undercover is applied first; only when it succeeds do the tools hide and the mode says "ON".
# User data (files) is never touched. To go back: shubham-kali

STATE_FILE="$HOME/.shubham-os-mode"
CURRENT="kali"
[ -f "$STATE_FILE" ] && CURRENT=$(cat "$STATE_FILE")
if [ "$CURRENT" = "windows" ]; then
  echo "Shubham OS: the system is already in Windows Mode."
  exit 0
fi
if ! command -v kali-undercover >/dev/null 2>&1; then
  echo "kali-undercover was not found. Run this first:"
  echo "sudo apt update && sudo apt install -y kali-undercover"
  exit 1
fi

# Undercover has its own check: xfconfd and xfce4-panel must both be running.
# If either one is stopped, it stops with "only works on Xfce desktop" — make sure both are running first.
ensure_xfce_processes() {
  if ! pgrep -u "$(id -un)" xfconfd >/dev/null 2>&1; then
    (xfconfd >/dev/null 2>&1 &)
  fi
  if ! pgrep -u "$(id -un)" xfce4-panel >/dev/null 2>&1; then
    (nohup xfce4-panel >/dev/null 2>&1 &)
  fi
  sleep 1
}
ensure_xfce_processes

# Run undercover with the correct desktop identity; if it fails, stop — never claim success falsely
if ! DESKTOP_SESSION=xfce XDG_CURRENT_DESKTOP=XFCE kali-undercover; then
  echo "Shubham OS: Windows Mode could NOT be applied (undercover error). Nothing was changed."
  exit 1
fi

# --- Hide the Kali tools from the menu (user-level NoDisplay overrides) ---
APP_DIR="$HOME/.local/share/applications"
STATE_DIR="$HOME/.config/shubham-os"
mkdir -p "$APP_DIR" "$STATE_DIR"
MANIFEST="$STATE_DIR/hidden-apps.txt"
: > "$MANIFEST"

keep_app() {
  case "$1" in
    *firefox*|*chromium*|*chrome*|*thunar*|*nautilus*|*mousepad*|*libreoffice*|\
    *vlc*|*parole*|*ristretto*|*evince*|*gimp*|*inkscape*|*code.desktop|\
    *xfce4-terminal*|*xfce4-settings-manager*|*xfce4-screenshooter*|\
    *nm-connection-editor*|*blueman-manager*|*calculat*|*engrampa*|*file-roller*|\
    *shubham-update*|*software*|*pamac*|*synaptic*) return 0 ;;
    *) return 1 ;;
  esac
}

for f in /usr/share/applications/*.desktop; do
  [ -f "$f" ] || continue
  base=$(basename "$f")
  keep_app "$base" && continue
  ovr="$APP_DIR/$base"
  cp "$f" "$ovr" 2>/dev/null || continue
  if grep -q '^NoDisplay=' "$ovr"; then
    sed -i 's/^NoDisplay=.*/NoDisplay=true/' "$ovr"
  else
    echo 'NoDisplay=true' >> "$ovr"
  fi
  echo "$base" >> "$MANIFEST"
done

echo "windows" > "$STATE_FILE"
xfce4-panel -r >/dev/null 2>&1 &
echo "Shubham OS: Windows Mode ON — Kali tools are hidden from the menu. To go back: shubham-kali"
