#!/bin/bash
# Shubham OS — Windows Mode ON karne ki command
# Kali ke undercover engine ko use karke desktop ko Windows jaisa banata hai.
# Wapas jaane ke liye: shubham-kali

STATE_FILE="$HOME/.shubham-os-mode"
CURRENT="kali"
[ -f "$STATE_FILE" ] && CURRENT=$(cat "$STATE_FILE")

if [ "$CURRENT" = "windows" ]; then
  echo "Shubham OS: system pehle se Windows Mode me hai."
  exit 0
fi

if ! command -v kali-undercover >/dev/null 2>&1; then
  echo "kali-undercover nahi mila. Pehle ye chalao:"
  echo "sudo apt update && sudo apt install -y kali-undercover"
  exit 1
fi

kali-undercover
echo "windows" > "$STATE_FILE"
echo "Shubham OS: Windows Mode ON ho gaya. Wapas Kali look ke liye: shubham-kali"
