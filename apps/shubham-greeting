#!/bin/bash
# Shubham OS — welcome voice. Runs ONCE when the session starts (via autostart).
# Live: OS on -> desktop -> voice. Install: AFTER the login/lock screen -> desktop -> voice.
# It never plays on the lock screen or before it (autostart runs with the session).
sleep 2
WAV=/usr/share/shubham-os/greeting.wav
[ -f "$WAV" ] || exit 0
if command -v paplay >/dev/null 2>&1; then
  paplay "$WAV" >/dev/null 2>&1
elif command -v aplay >/dev/null 2>&1; then
  aplay -q "$WAV" >/dev/null 2>&1
elif command -v ffplay >/dev/null 2>&1; then
  ffplay -nodisp -autoexit -loglevel quiet "$WAV" >/dev/null 2>&1
elif command -v mpv >/dev/null 2>&1; then
  mpv --no-video "$WAV" >/dev/null 2>&1
fi
exit 0
